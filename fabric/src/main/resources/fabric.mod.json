{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_authors}"],
    "contact": {},
    "license": "${mod_license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "modmenu": [
            "net.zeronexus.quickstackcraft.fabric.client.ModMenuIntegration"
        ],
        "emi": [
            "net.zeronexus.quickstackcraft.fabric.compat.emi.QuickStackCraftEmiPlugin"
        ],
        "jei_mod_plugin": [
            "net.zeronexus.quickstackcraft.fabric.compat.jei.QuickStackCraftJeiPlugin"
        ],
        "client": [
            "net.zeronexus.quickstackcraft.fabric.QuickStackCraftFabricClient"
        ],
        "main": [
            "net.zeronexus.quickstackcraft.fabric.QuickStackCraftFabric"
        ]
    },
    "mixins": [
        "quickstackcraft-common.mixins.json",
        "quickstackcraft.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "architectury": ">=${architectury_api_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": "*"
    }
}
